# Copiar a .env.local y completar

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API → https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram → hablar con @BotFather, /newbot
TELEGRAM_BOT_TOKEN=
# Cualquier texto largo y aleatorio (A-Z, a-z, 0-9, _ y -)
TELEGRAM_WEBHOOK_SECRET=

# URL pública de la app (Vercel o túnel tipo ngrok/cloudflared en desarrollo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: usuario del bot sin @, para mostrarlo en el panel
TELEGRAM_BOT_USERNAME=
# Nombre corto de la Mini App creada con /newapp en BotFather (para abrir el panel desde el grupo)
TELEGRAM_MINIAPP_NAME=panel

# Wompi → Dashboard de comercio → Desarrolladores (usa las llaves de pruebas primero)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_
WOMPI_INTEGRITY_SECRET=test_integrity_
WOMPI_EVENTS_SECRET=test_events_

# Secreto para el recordatorio diario (Vercel Cron lo envía solo si está configurado en el proyecto)
CRON_SECRET=

# Datos legales del responsable (aparecen en Términos y Política de datos)
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CITY=Bogotá D.C., Colombia
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=

# Notas de voz: Deepgram (https://console.deepgram.com) — la API de Claude no recibe audio
DEEPGRAM_API_KEY=

# Correos que pueden ver /admin/metricas (separados por coma)
ADMIN_EMAILS=

# Módulo de deudas (fuera del MVP según el PRD)
NEXT_PUBLIC_FEATURE_DEBTS=false
